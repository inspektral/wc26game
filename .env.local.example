# ----- Supabase (Project Settings -> API) -----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, never exposed to the browser.
# Used by /api/sync to write match results bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- football-data.org (free token: https://www.football-data.org/client/register) -----
FOOTBALL_DATA_TOKEN=your-football-data-token
# Competition code for the FIFA World Cup on football-data.org
FOOTBALL_DATA_COMPETITION=WC

# Shared secret protecting /api/sync from public calls. Make it long & random.
CRON_SECRET=change-me-to-a-long-random-string

# The single password your whole group shares to log in (>= 6 characters).
# Anyone with this + a display name can join, so don't post it publicly.
GROUP_PASSWORD=change-me
